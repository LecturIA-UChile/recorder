<Window x:Class="LecturIA.App.UserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LecturIA.App.ViewModels"
        mc:Ignorable="d"
        Title="Iniciar sesión en LecturIA"
        Height="560"
        Width="620"
        MinHeight="560"
        MinWidth="620"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        d:DataContext="{d:DesignInstance Type=vm:UserLoginViewModel}">
    <Grid ClipToBounds="True">
        <Ellipse Width="300"
                 Height="300"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-170,-130,0"
                 Fill="{DynamicResource AccentBrush}"
                 Opacity="0.08"/>
        <Ellipse Width="220"
                 Height="220"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-130,0,0,-120"
                 Fill="{DynamicResource AccentBrush}"
                 Opacity="0.06"/>

        <Border Width="500"
                Padding="42,34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource RowSelectedBrush}"
                        CornerRadius="36">
                    <Viewbox Width="36" Height="36">
                        <Grid Width="24" Height="24">
                            <Path Data="M4,5.5 C7.5,4.5 9.5,5.2 12,7 C14.5,5.2 16.5,4.5 20,5.5 L20,18.5 C16.5,17.5 14.5,18.2 12,20 C9.5,18.2 7.5,17.5 4,18.5 Z"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"/>
                            <Path Data="M12,7 L12,20"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           Text="Bienvenido a LecturIA"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Row="2"
                           Margin="24,8,24,0"
                           HorizontalAlignment="Center"
                           Text="Ingresa para comenzar a grabar las evaluaciones de dominio lector."
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>

                <Border Grid.Row="3"
                        Margin="0,24,0,0"
                        Padding="16,13"
                        Background="{DynamicResource RowSelectedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="20"
                                 Height="20"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center">
                            <Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,10 L12,17 M12,7 L12,7.1"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Se abrirá tu navegador para continuar. Al terminar, vuelve a la aplicación."
                                   FontSize="12.5"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding ErrorMessage}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="5"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center">
                    <Button Width="240"
                            Height="48"
                            Command="{Binding SignInCommand}"
                            IsEnabled="{Binding IsAuthenticationAvailable}"
                            IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Iniciar sesión"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Content" Value="Esperando confirmación..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="150"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Salir"/>
                                <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Content" Value="Cancelar intento"/>
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
