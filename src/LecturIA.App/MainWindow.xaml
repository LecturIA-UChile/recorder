<Window x:Class="LecturIA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LecturIA.App.ViewModels"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:LecturIA.App.Behaviors"
        mc:Ignorable="d"
        Title="LecturIA Recorder"
        Height="740"
        Width="1180"
        MinHeight="720"
        MinWidth="1000"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid ClipToBounds="True">
        <!-- Decorative shapes mirror the login without competing with the workspace. -->
        <Ellipse Width="380"
                 Height="380"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-230,-170,0"
                 Fill="{DynamicResource AccentBrush}"
                 Opacity="0.08"/>
        <Ellipse Width="280"
                 Height="280"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-170,0,0,-170"
                 Fill="{DynamicResource AccentBrush}"
                 Opacity="0.06"/>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand, active identity, and session actions. -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            Background="{DynamicResource RowSelectedBrush}"
                            CornerRadius="24">
                        <Viewbox Width="25" Height="25">
                            <Grid Width="24" Height="24">
                                <Path Data="M4,5.5 C7.5,4.5 9.5,5.2 12,7 C14.5,5.2 16.5,4.5 20,5.5 L20,18.5 C16.5,17.5 14.5,18.2 12,20 C9.5,18.2 7.5,17.5 4,18.5 Z"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M12,7 L12,20"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LecturIA Recorder"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Grabación de lecturas para la evaluación del dominio lector"
                                   Margin="0,2,0,0"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Padding="8,4"
                            Margin="0,0,14,0"
                            Background="{DynamicResource WarningBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Modo distribuidor"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningTextBrush}"/>
                    </Border>

                    <StackPanel Margin="0,0,14,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="38"
                                Height="38"
                                Margin="0,0,10,0"
                                Background="{DynamicResource RowSelectedBrush}"
                                CornerRadius="19">
                            <Viewbox Width="21" Height="21">
                                <Path Data="M12,3 A4,4 0 1 1 11.99,3 M4,22 C4,17.6 7.6,14 12,14 C16.4,14 20,17.6 20,22"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Width="190"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding AuthenticatedDisplayName}"
                                       ToolTip="{Binding AuthenticatedDisplayName}"
                                       HorizontalAlignment="Right"
                                       MaxWidth="190"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AuthenticatedRole, StringFormat='Rol: {0}'}"
                                       HorizontalAlignment="Right"
                                       MaxWidth="190"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Cerrar sesión"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Background="{DynamicResource MutedBrush}"
                            FontSize="12"
                            Padding="12,7"/>
                </StackPanel>
            </Grid>

            <!-- Primary workspace. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <!-- Course and student card. -->
                <Border Grid.Column="0"
                        Padding="16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Estudiantes"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Selecciona a quien realizará la lectura"
                                           Margin="0,2,0,0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Importar curso"
                                    Command="{Binding AddCourseCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,7"
                                    FontSize="12"
                                    Visibility="{Binding CanManageCourses, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <!-- Current course summary or selector. -->
                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="12,10"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="{Binding HasAnyCourse, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Curso"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSingleCourse, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedCourse.CourseLabel, FallbackValue=''}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedCourse.SchoolLabel, FallbackValue=''}"
                                               Margin="0,1,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Courses}"
                                          SelectedItem="{Binding SelectedCourse}"
                                          IsEnabled="{Binding IsIdle}"
                                          FontSize="12"
                                          Visibility="{Binding HasMultipleCourses, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding CourseLabel}" FontSize="12"/>
                                                <TextBlock Text="{Binding SchoolLabel}"
                                                           Margin="0,1,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="2"
                                        Content="Eliminar"
                                        Command="{Binding DeleteCurrentCourseCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding CanManageCourses, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <!-- Course-limit feedback remains restricted to course managers. -->
                        <Grid Grid.Row="2"
                              Visibility="{Binding CanManageCourses, Converter={StaticResource BoolToVisibility}}">
                            <Border Margin="0,8,0,0"
                                    Padding="10,7"
                                    Background="{DynamicResource WarningBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding CanAddMoreCourses, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource WarningTextBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="9">
                                        <TextBlock Text="!"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningTextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Path=(vm:MainViewModel.CourseLimitMessage)}"
                                               VerticalAlignment="Center"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource WarningTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Student search with vector magnifier. -->
                        <Border Grid.Row="3"
                                Margin="0,12,0,8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SearchBox"
                                         Grid.Column="0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Background="{DynamicResource SurfaceBrush}"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource TextBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         FontSize="12.5"
                                         VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Column="0"
                                           Text="Busca estudiantes por RUT, nombre o apellido..."
                                           Padding="11,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Viewbox Grid.Column="1"
                                         Width="16"
                                         Height="16"
                                         Margin="8,0,10,0"
                                         IsHitTestVisible="False">
                                    <Path Data="M7,1 A6,6 0 1 1 6.99,1 M11.5,11.5 L16,16"
                                          Stroke="{DynamicResource PlaceholderBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Student roster. -->
                        <Border Grid.Row="4"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <ListView ItemsSource="{Binding StudentsView}"
                                          SelectedItem="{Binding SelectedStudent}"
                                          IsEnabled="{Binding IsIdle}"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderThickness="0"
                                          FontSize="12.5"
                                          Foreground="{DynamicResource TextBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <b:Interaction.Behaviors>
                                        <behaviors:StretchColumnsGridViewBehavior/>
                                    </b:Interaction.Behaviors>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="RUT" DisplayMemberBinding="{Binding Rut}"/>
                                            <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding FirstName}"/>
                                            <GridViewColumn Header="Apellido" DisplayMemberBinding="{Binding LastName}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <TextBlock Text="No hay estudiantes en este curso."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HasNoStudents, Converter={StaticResource BoolToVisibility}}"/>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                    <Canvas Width="32" Height="32" HorizontalAlignment="Center">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotation" CenterX="16" CenterY="16"/>
                                        </Canvas.RenderTransform>
                                        <Canvas.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Canvas.Triggers>
                                        <Path Stroke="{DynamicResource MutedBrush}"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="16,2" IsClosed="False">
                                                        <ArcSegment Point="30,16"
                                                                    Size="14,14"
                                                                    SweepDirection="Clockwise"
                                                                    IsLargeArc="False"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                    <TextBlock Text="Cargando datos..."
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5"
                                Margin="0,10,0,0"
                                Padding="11,8"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estudiante seleccionado: "
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding SelectedStudent.DisplayLabel, TargetNullValue=Ninguno}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Reading selection remains separate from the application protocol. -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="14,11"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,11,0"
                                    Background="{DynamicResource RowSelectedBrush}"
                                    CornerRadius="17">
                                <Viewbox Width="18" Height="18">
                                    <Grid Width="24" Height="24">
                                        <Path Data="M4,5.5 C7.5,4.5 9.5,5.2 12,7 C14.5,5.2 16.5,4.5 20,5.5 L20,18.5 C16.5,17.5 14.5,18.2 12,20 C9.5,18.2 7.5,17.5 4,18.5 Z"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8"
                                              StrokeLineJoin="Round"/>
                                        <Path Data="M12,7 L12,20"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lectura"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Selecciona el texto entregado al estudiante"
                                               Margin="0,1,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ReadingTextsView}"
                                          SelectedItem="{Binding SelectedReadingText}"
                                          DisplayMemberPath="MenuLabel"
                                          IsEnabled="{Binding IsIdle}"
                                          FontSize="12"
                                          MaxDropDownHeight="220"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- All protocol instructions remain visible without scrolling. -->
                    <Border Grid.Row="2"
                            Padding="18,16"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Antes de grabar"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Protocolo de aplicación"
                                       Margin="0,2,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <!-- Preparation checklist. -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <Ellipse Width="5"
                                     Height="5"
                                     Margin="0,7,0,0"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center"
                                     Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="Trabaja individual con el estudiante en un ambiente silencioso"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <Ellipse Width="5"
                                     Height="5"
                                     Margin="0,7,0,0"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center"
                                     Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="Ubica el computador de manera tal que asegure la grabación de la voz"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <Ellipse Width="5"
                                     Height="5"
                                     Margin="0,7,0,0"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center"
                                     Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="Selecciona antes: curso, estudiante y lectura"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Teacher script presented as the login-style information panel. -->
                        <Border Grid.Row="2"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                Background="{DynamicResource RowSelectedBrush}"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Explique la actividad:"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="&quot;vas a leer en voz alta una lectura y tu voz se va a grabar en esta aplicación del computador&quot; (mostrar)"
                                               Margin="0,2,0,0"
                                               FontFamily="Georgia"
                                               FontSize="13.5"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0.45"/>

                                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                    <TextBlock Text="Entregue la lectura y diga:"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="&quot;LEE EN VOZ ALTA LO MEJOR QUE PUEDAS ESTA LECTURA. COMIENZA&quot;"
                                               Margin="0,2,0,0"
                                               FontFamily="Georgia"
                                               FontSize="13.5"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Closing considerations keep their own full-width list rows. -->
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="5"
                                         Height="5"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Center"
                                         Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="El cronómetro corre automático. A los 60s, marca la palabra donde va (puede terminar la oración)"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="5"
                                         Height="5"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Center"
                                         Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="Al terminar, di algo amable (Ej: &quot;Muy bien&quot;, &quot;Te felicito&quot;)"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="4"
                                Margin="0,14,0,0"
                                Background="{DynamicResource RecordBrush}"
                                CornerRadius="8"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{Binding RecordButtonBlockedReason}"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.ShowDuration="20000">
                            <Button Height="42"
                                    Command="{Binding ToggleRecordingCommand}"
                                    Style="{StaticResource RecordButton}"
                                    Background="{DynamicResource RecordBrush}"
                                    Foreground="{DynamicResource SurfaceBrush}"
                                    FontSize="14.5"
                                    Padding="16,8"
                                    MinWidth="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Width="15"
                                          Height="15"
                                          Margin="0,0,9,0"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource SurfaceBrush}"
                                          Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 M17.3,11 C17.3,14 14.76,16.1 12,16.1 C9.24,16.1 6.7,14 6.7,11 L5,11 C5,14.41 7.72,17.23 11,17.72 L11,21 L13,21 L13,17.72 C16.28,17.23 19,14.41 19,11 Z"/>
                                    <TextBlock Text="Comenzar grabación"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Compact recording controls and vector timer. -->
            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding RecordButtonBlockedReason}"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="20000">
                        <Button Content="{Binding RecordButtonText}"
                                Command="{Binding ToggleRecordingCommand}"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RecordButton}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Padding" Value="15,9"/>
                                    <Setter Property="MinWidth" Value="145"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StopBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Micrófono"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AudioInputDevices}"
                                  SelectedItem="{Binding SelectedAudioInput}"
                                  DisplayMemberPath="Name"
                                  Style="{DynamicResource AudioInputComboBox}"
                                  MaxDropDownHeight="220"
                                  ToolTip="Selecciona el micrófono que se usará al grabar."/>
                        <ProgressBar Grid.Column="2"
                                     Value="{Binding AudioInputLevel}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Margin="12,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource HeaderBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     ToolTip="Nivel de entrada del micrófono"/>
                        <Button Grid.Column="3"
                                Content="{Binding AudioTestButtonText}"
                                Command="{Binding ToggleAudioTestCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="4,0,0,0"
                                Padding="11,7"
                                FontSize="11.5"
                                MinWidth="68"
                                ToolTip="Graba una muestra temporal para comprobar el micrófono."/>
                        <Button Grid.Column="4"
                                Content="{Binding AudioPlaybackButtonText}"
                                Command="{Binding ToggleAudioTestPlaybackCommand}"
                                Margin="7,0,0,0"
                                Padding="11,7"
                                FontSize="11.5"
                                MinWidth="72"
                                ToolTip="Escucha o detiene la última prueba de micrófono.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayingAudioTest}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Margin="18,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="21">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimeUp}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox Width="24" Height="24">
                                <Path Data="M9,2 L15,2 M12,2 L12,5 M17.8,6.2 L19.5,4.5 M12,5 A8,8 0 1 1 11.99,5 M12,8.5 L12,13 L15,15"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimeUp}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                        </Border>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Tiempo"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding ElapsedTimeText}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="22"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimeUp}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Operational feedback stays compact to preserve workspace height. -->
            <StackPanel Grid.Row="3" Margin="2,9,2,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding RecordingsFolderHint}"
                           Margin="0,2,0,0"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>

            <!-- The countdown covers the workspace and starts the recorder after its cue. -->
            <Border Grid.RowSpan="4"
                    Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding IsCountingDown, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CountdownText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="46"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           RenderTransformOrigin="0.5,0.5"
                           TextAlignment="Center">
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCountingDown}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="CountdownPulseStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="0.7"
                                                                 To="1.0"
                                                                 Duration="0:0:1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.7"
                                                                 To="1.0"
                                                                 Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="CountdownPulseStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
