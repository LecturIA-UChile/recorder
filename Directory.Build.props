<Project>

    <!--
        Properties shared by every project in the solution. Per-project
        .csproj files only declare project-specific values (OutputType,
        UseWPF, package references).
    -->

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup Label="Product information">
        <Product>LecturIA</Product>
        <Company>Facultad de Ciencias Físicas y Matemáticas, Universidad de Chile</Company>
        <Copyright>Copyright © 2026 Facultad de Ciencias Físicas y Matemáticas, Universidad de Chile</Copyright>
        <Version>1.0.0</Version>
        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
    </PropertyGroup>

</Project>
