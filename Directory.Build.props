<Project>

    <!--
        Properties shared by every project in the solution. Per-project
        .csproj files only declare project-specific values (OutputType,
        UseWPF, package references).
    -->

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup Label="Product information">
        <Product>LecturIA</Product>
        <Company>Facultad de Ciencias Físicas y Matemáticas, Universidad de Chile</Company>
        <Copyright>Copyright © 2026 Facultad de Ciencias Físicas y Matemáticas, Universidad de Chile</Copyright>
    </PropertyGroup>

    <!--
        MinVer derives Version, FileVersion, and AssemblyVersion from the
        nearest reachable git tag (format: vMAJOR.MINOR.PATCH).
        The fallback below is used only when no tag exists yet (e.g. first
        local build before the repo has any tag).
    -->
    <ItemGroup>
        <PackageReference Include="MinVer" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup Label="MinVer configuration">
        <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

</Project>
